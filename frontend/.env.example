# Public API URL — on PC use /api (Vite proxy). On phone (192.168.x.x) the app auto-uses :5001.
# Do NOT set http://localhost:5001 — phones cannot reach localhost on your PC.
VITE_API_URL=/api

# Backend port for direct mobile API calls (default 5001)
# VITE_API_PORT=5001

# Optional: Stripe publishable key (pk_test_...) for embedded card UI only.
# Hosted Checkout redirect does NOT require this. NEVER use sk_ secret keys in the frontend.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Set to false to use local mockData.js when API is unavailable
# VITE_USE_API=true

# Google Maps — FRONTEND browser key
# Enable in Google Cloud: Billing + Maps JavaScript API + Places API (New)
# API key restrictions must include BOTH:
#   - Maps JavaScript API
#   - Places API (New)          ← required for address suggestions (new keys since Mar 2025)
# Application restrictions: HTTP referrers e.g. http://localhost:5173/*
# VITE_GOOGLE_MAPS_API_KEY=your_frontend_browser_api_key
#
# Optional: Map ID from Google Cloud → Map Management (advanced vector markers).
# Leave unset to use classic markers (recommended until billing is configured).
# VITE_GOOGLE_MAPS_MAP_ID=

# Hide live tracking map when driver GPS is stale (minutes; match backend TRACKING_MAP_HIDE_MINUTES)
# VITE_TRACKING_MAP_HIDE_MINUTES=5

# Use OpenStreetMap for map tiles only (saves Google billing). Address search still uses
# VITE_GOOGLE_MAPS_API_KEY for live suggestions when set.
# VITE_USE_OSM_MAP=true
