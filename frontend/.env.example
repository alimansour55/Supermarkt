# Storefront SSR server (npm run build && npm start)

# Port the SSR server listens on
PORT=3000

# Public site origin — used for canonical URLs, hreflang, Open Graph and the sitemap.
# REQUIRED in production, e.g. https://www.example.com (falls back to the request origin).
# SITE_URL=https://www.example.com

# Express API as seen from the SSR server (server-side data loading)
API_INTERNAL_URL=http://127.0.0.1:5001/api

# Proxy /api/* to the Express API from this server. Leave unset when Nginx/Caddy routes /api.
# API_PROXY_TARGET=http://127.0.0.1:5001

# Browser-side API base (default: same-origin /api). For the Capacitor app build, point at the
# public API, e.g. VITE_API_URL=https://www.example.com/api
# VITE_API_URL=/api
