# Public API URL — use /api with Vite dev proxy (recommended) or full URL in production
VITE_API_URL=/api

# Optional: Stripe publishable key (pk_test_...) for embedded card UI only.
# Hosted Checkout redirect does NOT require this. NEVER use sk_ secret keys in the frontend.
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Set to false to use local mockData.js when API is unavailable
# VITE_USE_API=true
