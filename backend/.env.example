# Server
PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/marketplus

# JWT — use a long random string (32+ chars in production)
JWT_SECRET=dev_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS, Stripe redirects & email links)
CLIENT_URL=http://localhost:5173

# Port shown in "Open on your phone" hints when the API starts (default 5173)
# FRONTEND_PORT=5173

# Phone on same Wi‑Fi: LAN origins are allowed automatically in development.
# For Stripe redirects from a phone, set CLIENT_URL to your PC IP, e.g.:
# CLIENT_URL=http://192.168.1.42:5173

# Extra allowed origins (comma-separated) for production deployments
# CORS_ORIGINS=https://www.example.com,https://admin.example.com

# Admin panel — shared password for /admin/login (required in production)
ADMIN_PASSWORD=admin123

# ── Online payments (Egypt) ────────────────────────────────────────────────
# Each method appears at checkout only once its keys below are set.
# Gateways call back to {PUBLIC_API_URL}/payment/... — must be public HTTPS in production.
# Defaults to {CLIENT_URL}/api (right behind the bundled Caddy proxy).
# PUBLIC_API_URL=https://www.yourstore.com/api

# Paymob — Dashboard → Settings → API Keys / Payment Integrations (test and live keys differ)
# PAYMOB_SECRET_KEY=egy_sk_test_...
# PAYMOB_PUBLIC_KEY=egy_pk_test_...
# PAYMOB_HMAC_SECRET=...
# PAYMOB_API_KEY=...                 # optional: lets the server double-check missed callbacks
# PAYMOB_INTEGRATION_CARD=1234567    # Visa / Mastercard / Meeza
# PAYMOB_INTEGRATION_APPLE_PAY=      # optional, shown on Apple devices with the card method
# PAYMOB_INTEGRATION_WALLET=         # Vodafone Cash / Orange / Etisalat / WE Pay
# PAYMOB_INTEGRATION_VALU=           # valU instalments
# PAYMOB_BASE_URL=https://accept.paymob.com

# Fawry — Pay at Fawry reference numbers (staging until FAWRY_ENV=production)
# FAWRY_MERCHANT_CODE=...
# FAWRY_SECURE_KEY=...
# FAWRY_ENV=staging
# FAWRY_EXPIRY_HOURS=48

# Mobile app deep link Paymob returns to (default below)
# APP_PAYMENT_RETURN_URL=marketplus://app/payment/result

# Stripe — legacy only (Stripe does not onboard Egypt-based merchants)
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Twilio SMS (MFA / OTP) — optional in dev (OTP logged to console)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
# SMS_DEV_MODE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=MarketPlus <noreply@marketplus.com>
ADMIN_EMAIL=admin@marketplus.com
# Google Maps — BACKEND server key (address search + geocoding + directions)
# Google Cloud → Credentials → Backend key → API restrictions MUST include:
#   Places API (New), Geocoding API, Directions API
# Application restrictions: None (local dev) or your server IP (production)
# GOOGLE_MAPS_API_KEY=your_backend_google_maps_api_key
# Run: npm run check:maps — validates key + Places API access

# Live delivery tracking — hide customer map when driver GPS is older than N minutes (default 5)
# TRACKING_MAP_HIDE_MINUTES=5

# Product search engine (Meilisearch) — optional. Unset = MongoDB search (no relevance
# ranking, weaker Arabic typo handling). Docker Compose sets both values in production.
# Local: run Meilisearch with --master-key, then: npm run search:reindex
# MEILI_HOST=http://127.0.0.1:7700
# MEILI_API_KEY=your_meili_master_key
# MEILI_INDEX=products
# MEILI_FULL_SYNC_HOURS=6     # periodic safety-net rebuild (0 = off)
# SEARCH_ENGINE=mongo         # force MongoDB search even when MEILI_HOST is set

# AI store assistant (OpenAI — server-side only)
# OPENAI_API_KEY=sk-your_openai_api_key
# ASSISTANT_MODEL=gpt-4o-mini
# ASSISTANT_ENABLED=true
# ASSISTANT_MAX_HISTORY=10
# ASSISTANT_TEMPERATURE=0.75

# WhatsApp Cloud API (live chat inbound routing) - optional
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
