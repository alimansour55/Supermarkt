# Server
PORT=5001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/marketplus

# JWT — use a long random string (32+ chars in production)
JWT_SECRET=dev_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS, Stripe redirects & email links)
CLIENT_URL=http://localhost:5173

# Extra allowed origins (comma-separated) for production deployments
# CORS_ORIGINS=https://www.example.com,https://admin.example.com

# Stripe — secret keys stay on the server only
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Twilio SMS (MFA / OTP) — optional in dev (OTP logged to console)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
# SMS_DEV_MODE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=MarketPlus <noreply@marketplus.com>
ADMIN_EMAIL=admin@marketplus.com
LOW_STOCK_THRESHOLD=10
