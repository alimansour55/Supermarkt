# Copy to the repository root as .env (read by docker compose).

# Canonical host — the address customers and Google should use.
SITE_DOMAIN=www.example.com
# The other spelling (apex or www) — permanently redirected to SITE_DOMAIN.
REDIRECT_DOMAIN=example.com
# Full public URL — used for canonical links, hreflang, sitemap and CORS (must match SITE_DOMAIN).
SITE_URL=https://www.example.com
# Let's Encrypt account e-mail (certificate expiry notices).
ACME_EMAIL=you@example.com
